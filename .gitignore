# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# model weights -- NEVER commit these
# The champion trunk is ViT-L/14: 1219 MB at fp32, 611 MB at fp16. Both are past
# GitHub's 100 MB blob limit, so the graph is hosted externally and pointed at by
# NEXT_PUBLIC_MODEL_URL. model_meta.json is small and IS committed.
*.onnx
public/models/cleavage*.onnx

# export scratch
export_champ*.log
shrink.log
scripts/__pycache__/
__pycache__/

# macOS AppleDouble sidecars, from the corpus drive
._*
